# Development telemetry (written by .claude/hooks/telemetry.mjs).
# ⚠ This is the record of how work was handed to the AI, not anything the product emits.
# ⚠ It never leaves this machine and it never enters git.
# ⚠ The exact string below is also declared in .claude/telemetry-dir.mjs
#   (TELEMETRY_IGNORE_LINE). ⚠ If you change one, change the other.
#   ⚠ .claude/tools/docs-check.mjs case `telemetry-ignore-line` holds the two together.
.claude/telemetry/

# ⚠ Another session's working copy (git worktree). ⚠ It is a full copy of this repository,
#   so tracking it means `git add -A` sweeps another session's work in.
.claude/worktrees/

# ⚠ Local secrets. ⚠ This repository is public — see .claude/rules/security.md § 6.
#   ⚠ .env.example is tracked and carries names only, never values.
.env
.env.*
!.env.example
.envrc

# Cloudflare Tunnel credentials (cloudflared writes these next to its config).
# ⚠ A tunnel credential file is a long-lived secret.
*.pem
cert.pem
tunnel-credentials.json
.cloudflared/

# Node
node_modules/
npm-debug.log*
.npm/

# Build output and caches
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
*.swp

# ⚠ Field-test scratch. ⚠ Observations belong on the issue, not in git.
tmp/

# ⚠ wrangler のローカルキャッシュ。⚠ **コミットしない**
.wrangler/
spike/.wrangler/
